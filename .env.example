# Environment
NODE_ENV=production

# Server
PORT=3000

# Database (MongoDB Atlas or your production MongoDB URL)
DB_URL=mongodb+srv://username:password@cluster.mongodb.net/resq?retryWrites=true&w=majority

# Session Secret (MUST be a strong random string - generate with: openssl rand -base64 32)
SESSION_SECRET=your-super-secure-random-session-secret-at-least-32-characters-long

# Cloudinary (Image Upload Service)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET=your_cloudinary_api_secret

# Mapbox (Map Service)
MAPBOX_TOKEN=your_mapbox_public_token
