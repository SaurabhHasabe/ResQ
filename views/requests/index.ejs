<% layout('layouts/boilerplate') %>

<!-- Map JS dependency -->
<script>
    window.requestPopups = <%- JSON.stringify(requests.filter(r => r.status === 'open').map(r => ({
        coordinates: r.location.coordinates,
        popupMarkup: `<b>${r.type.toUpperCase()}</b><br>Urgency: ${r.urgency}<br><a href="/requests/${r._id}">View</a>`
    }))) %>;
</script>

<div class="row mb-4 align-items-center">
    <div class="col-md-8 text-center text-md-start">
        <h1 class="mb-0">Aid Requests</h1>
    </div>
    <div class="col-md-4 text-center text-md-end">
        <a href="/requests/new" class="btn btn-primary">
            <i data-lucide="life-buoy" style="width: 16px; height: 16px;"></i>
            Request Aid
        </a>
    </div>
</div>

<!-- Map at the top, full width -->
<div id="map" class="mb-4" style="height: 400px; border-radius: 8px;"></div>

<!-- Requests in grid below -->
<% if (requests.length === 0) { %>
    <div class="empty-state">
        <i data-lucide="inbox" class="icon-lg mx-auto text-muted mb-3 d-block"></i>
        <h4>No requests found</h4>
        <p>No active aid requests have been submitted.</p>
    </div>
<% } else { %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        <% for (let r of requests) { %>
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title text-capitalize mb-0"><%= r.type %></h5>
                            <span class="badge badge-severity-<%= r.urgency %>"><%= r.urgency %></span>
                        </div>

                        <p class="card-text text-muted small mb-2">
                            <i data-lucide="map-pin" style="width: 14px; height: 14px;"></i>
                            <%= r.address %>
                        </p>

                        <p class="card-text flex-grow-1 mb-3">
                            <%= r.description.length > 120 ? r.description.substring(0, 120) + '...' : r.description %>
                        </p>

                        <div class="mb-3">
                            <span class="badge badge-<%= r.status %>">
                                <%= r.status.toUpperCase() %>
                            </span>
                        </div>

                        <% if (r.linkedIncident) { %>
                            <p class="mb-2 small text-info">
                                <i data-lucide="link" style="width: 12px; height: 12px;"></i>
                                Linked to incident
                            </p>
                        <% } %>

                        <a href="/requests/<%= r._id %>" class="btn btn-sm btn-outline-primary mt-auto w-100">View Details</a>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
<% } %>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        initializeMap('map', 20.5937, 78.9629, 4, true, window.requestPopups);
    });
</script>
