<% layout('layouts/boilerplate') %>
<div class="text-center mb-4">
        <h1 class="mb-2">On-ground work</h1>
        <p class="text-muted">Update assigned tasks, and accept or reject nearby reports when you are the closest volunteer.</p>
    </div>

    <% if (currentUser.role === 'volunteer') { %>
        <% if (!hasLocation) { %>
            <div class="alert alert-warning">Allow location so ResQ can show reports nearest to you. Reload after granting permission.</div>
        <% } %>

        <% if (nearbyIncidents && nearbyIncidents.length) { %>
            <h4 class="mb-3">Nearby incident reports</h4>
            <div class="row">
                <% for (const inc of nearbyIncidents) { %>
                    <div class="col-12 col-md-6 mb-3">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title"><%= inc.title %></h5>
                                <p class="small text-muted mb-1"><%= inc.address %></p>
                                <p class="small mb-3"><%= inc.distanceLabel %> away · <%= inc.selfReportedSeverity %> severity</p>
                                <a href="/incidents/<%= inc._id %>" class="btn btn-sm btn-outline-primary mb-3">Open report</a>
                                <form action="<%= formAction('/incidents/' + inc._id + '/review') %>" method="POST">
                                    <%- include('../includes/csrf') %>
                                    <input type="hidden" name="verifiedSeverity" value="<%= inc.selfReportedSeverity %>">
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-sm btn-primary flex-grow-1" name="status" value="verified">Accept</button>
                                        <button class="btn btn-sm btn-outline-danger flex-grow-1" name="status" value="rejected">Reject</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } else if (hasLocation) { %>
            <div class="alert alert-success">No nearby incident reports waiting for you.</div>
        <% } %>

        <% if (nearbyRequests && nearbyRequests.length) { %>
            <h4 class="mb-3 mt-2">Nearby aid requests</h4>
            <div class="row">
                <% for (const req of nearbyRequests) { %>
                    <div class="col-12 col-md-6 mb-3">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title text-capitalize"><%= req.type %></h5>
                                <p class="small text-muted mb-1"><%= req.address %></p>
                                <p class="small mb-3"><%= req.distanceLabel %> away · urgency <%= req.urgency %></p>
                                <a href="/requests/<%= req._id %>" class="btn btn-sm btn-outline-primary mb-3">View request</a>
                                <form action="<%= formAction('/requests/' + req._id + '/claim') %>" method="POST">
                                    <%- include('../includes/csrf') %>
                                    <button class="btn btn-sm btn-primary w-100">Accept this request</button>
                                </form>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>
    <% } %>

    <h4 class="mb-3 mt-4">Your assignments</h4>
    <div class="row mt-3">
        <% if (assignments.length === 0) { %>
            <div class="col-12"><div class="empty-state"><i data-lucide="clipboard-list" class="icon-lg mx-auto text-muted mb-3 d-block"></i><h4>No assignments</h4><p>You have no assigned tasks at the moment.</p></div></div>
        <% } %>
        <% for(let a of assignments) { %>
            <div class="col-12 col-md-6 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title"><%= a.targetType.toUpperCase() %>: <%= a.targetId ? (a.targetId.title || a.targetId.type) : 'Deleted target' %></h5>
                        <p class="card-text mb-1">
                            <strong>Status:</strong>
                            <% if (a.status === 'resolved') { %>
                                <span class="badge bg-success">resolved</span>
                            <% } else { %>
                                <%= a.status %>
                            <% } %>
                        </p>
                        <p class="card-text mb-2"><small class="text-muted">Assigned on: <%= new Date(a.createdAt).toLocaleDateString() %></small></p>
                        
                        <% if(a.targetId && a.targetType === 'incident') { %>
                            <a href="/incidents/<%= a.targetId._id %>" class="btn btn-sm btn-outline-primary mb-3">View Target Incident</a>
                        <% } else if(a.targetId && a.targetType === 'request') { %>
                            <a href="/requests/<%= a.targetId._id %>" class="btn btn-sm btn-outline-primary mb-3">View Target Request</a>
                        <% } %>

                        <% if (a.status === 'resolved') { %>
                            <% if (a.fieldNotes) { %>
                                <p class="small mb-0"><strong>Field notes</strong></p>
                                <p class="small text-muted mb-0"><%= a.fieldNotes %></p>
                            <% } else { %>
                                <p class="small text-muted mb-0">This task is closed. No further updates.</p>
                            <% } %>
                        <% } else { %>
                        <form action="<%= formAction('/assignments/' + a._id) %>" method="POST">
                            <%- include('../includes/csrf') %>
                            <input type="hidden" name="_method" value="PUT">
                            <div class="mb-2">
                                <select name="status" class="form-select form-select-sm" required>
                                    <option value="assigned" <%= a.status === 'assigned' ? 'selected' : '' %>>Assigned</option>
                                    <option value="en_route" <%= a.status === 'en_route' ? 'selected' : '' %>>En Route</option>
                                    <option value="in_progress" <%= a.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
                                    <option value="resolved" <%= a.status === 'resolved' ? 'selected' : '' %>>Resolved</option>
                                </select>
                            </div>
                            <div class="mb-2">
                                <textarea name="fieldNotes" class="form-control form-control-sm" maxlength="2000" placeholder="Field Notes..."><%= a.fieldNotes %></textarea>
                            </div>
                            <button class="btn btn-sm btn-primary w-100">Update Assignment</button>
                        </form>
                        <% } %>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
