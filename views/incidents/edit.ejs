<% layout('layouts/boilerplate') %>
<div class="row justify-content-center">
    <div class="col-md-8">
        <h2 class="mb-4">Edit Incident</h2>
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <form action="/incidents/<%= incident._id %>?_method=PUT" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label class="form-label" for="title">Title</label>
                        <input class="form-control" type="text" id="title" name="incident[title]" value="<%= incident.title %>" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="category">Category</label>
                        <select class="form-select" id="category" name="incident[category]" required>
                            <option value="flood" <%= incident.category === 'flood' ? 'selected' : '' %>>Flood</option>
                            <option value="fire" <%= incident.category === 'fire' ? 'selected' : '' %>>Fire</option>
                            <option value="earthquake" <%= incident.category === 'earthquake' ? 'selected' : '' %>>Earthquake</option>
                            <option value="building collapse" <%= incident.category === 'building collapse' ? 'selected' : '' %>>Building Collapse</option>
                            <option value="other" <%= incident.category === 'other' ? 'selected' : '' %>>Other</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="severity">Severity</label>
                        <select class="form-select" id="severity" name="incident[selfReportedSeverity]" required>
                            <option value="low" <%= incident.selfReportedSeverity === 'low' ? 'selected' : '' %>>Low</option>
                            <option value="medium" <%= incident.selfReportedSeverity === 'medium' ? 'selected' : '' %>>Medium</option>
                            <option value="high" <%= incident.selfReportedSeverity === 'high' ? 'selected' : '' %>>High</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="description">Description</label>
                        <textarea class="form-control" type="text" id="description" name="incident[description]" required><%= incident.description %></textarea>
                    </div>

                    <h5 class="mt-4">Location</h5>
                    <p class="text-muted small">Update pin location on the map.</p>
                    <div id="map" class="mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label" for="address">Address (Text)</label>
                        <input class="form-control" type="text" id="address" name="incident[address]" value="<%= incident.address %>" required>
                    </div>
                    <!-- Prefill with existing coordinates -->
                    <input type="hidden" name="incident[latitude]" id="latitude" value="<%= incident.location.coordinates[1] %>" required>
                    <input type="hidden" name="incident[longitude]" id="longitude" value="<%= incident.location.coordinates[0] %>" required>

                    <button class="btn btn-primary mt-3 w-100">Update Report</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const lat = <%= incident.location.coordinates[1] %>;
        const lng = <%= incident.location.coordinates[0] %>;
        initializeMap('map', lat, lng, 13, false);
    });
</script>
