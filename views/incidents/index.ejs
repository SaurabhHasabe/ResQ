<% layout('layouts/boilerplate') %>

<!-- Pass popups array to window for map.js -->
<script>
    window.incidentPopups = <%- JSON.stringify(popups) %>;
</script>

<div class="row mb-4 align-items-center">
    <div class="col-12 col-md-4 text-center text-md-start">
        <h1 class="mb-0">Verified Incidents</h1>
    </div>
    <div class="col-12 col-md-auto text-center text-md-start ms-md-auto mt-2 mt-md-0">
        <a href="/incidents/new" class="btn btn-primary btn-block-mobile justify-content-center">
            <i data-lucide="alert-triangle" style="width: 16px; height: 16px;"></i>
            Report Incident
        </a>
    </div>
</div>

<div class="card bg-white mb-4 p-3 shadow-sm border filter-panel-mobile" style="transform: none; animation: none;">
    <button class="btn btn-outline-secondary filter-toggle d-lg-none mb-3" type="button" id="filter-toggle-btn">
        <span>Show Filters</span>
        <i data-lucide="chevron-down" id="filter-chevron" style="width: 16px; height: 16px; margin-left: 0.5rem;"></i>
    </button>
    <form action="/incidents" method="GET" class="row gx-3 gy-2 align-items-center filter-content" id="filter-content">
        <div class="col-md-4">
            <select name="category" class="form-select">
                <option value="">All Categories</option>
                <option value="flood" <%= category === 'flood' ? 'selected' : '' %>>Flood</option>
                <option value="fire" <%= category === 'fire' ? 'selected' : '' %>>Fire</option>
                <option value="earthquake" <%= category === 'earthquake' ? 'selected' : '' %>>Earthquake</option>
                <option value="building collapse" <%= category === 'building collapse' ? 'selected' : '' %>>Building Collapse</option>
                <option value="other" <%= category === 'other' ? 'selected' : '' %>>Other</option>
            </select>
        </div>
        <div class="col-md-4">
            <select name="severity" class="form-select">
                <option value="">All Severities</option>
                <option value="high" <%= severity === 'high' ? 'selected' : '' %>>High</option>
                <option value="medium" <%= severity === 'medium' ? 'selected' : '' %>>Medium</option>
                <option value="low" <%= severity === 'low' ? 'selected' : '' %>>Low</option>
            </select>
        </div>
        <div class="col-md-auto ms-auto">
            <button type="submit" class="btn btn-primary d-flex align-items-center gap-2 btn-block-mobile">
                <i data-lucide="filter" style="width: 16px; height: 16px;"></i>
                Apply Filter
            </button>
        </div>
    </form>
</div>

<script>
// Filter toggle functionality
document.addEventListener('DOMContentLoaded', function() {
    const toggleBtn = document.getElementById('filter-toggle-btn');
    const filterContent = document.getElementById('filter-content');
    const chevron = document.getElementById('filter-chevron');

    if (toggleBtn && filterContent) {
        // Auto-collapse on mobile by default
        if (window.innerWidth < 992) {
            filterContent.style.display = 'none';
        }

        toggleBtn.addEventListener('click', function() {
            if (filterContent.style.display === 'none') {
                filterContent.style.display = 'flex';
                chevron.style.transform = 'rotate(180deg)';
                toggleBtn.querySelector('span').textContent = 'Hide Filters';
            } else {
                filterContent.style.display = 'none';
                chevron.style.transform = 'rotate(0deg)';
                toggleBtn.querySelector('span').textContent = 'Show Filters';
            }
        });
    }
});
</script>

<!-- Map at the top, full width -->
<div id="map" class="mb-4 page-map"></div>

<!-- Incidents in grid below -->
<% if (incidents.length === 0) { %>
    <div class="empty-state">
        <i data-lucide="map-pin-off" class="icon-lg mx-auto text-muted mb-3 d-block"></i>
        <h4>No incidents found</h4>
        <p>There are no verified incidents matching your filters.</p>
    </div>
<% } else { %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        <% for (let incident of incidents) { %>
            <div class="col">
                <div class="card card-hoverable h-100 shadow-sm border-0">
                    <% if(incident.photos && incident.photos.length) { %>
                        <img src="<%= incident.photos[0].url %>" class="card-img-top" style="object-fit: cover; height: 180px;" alt="Incident Image">
                    <% } %>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title"><%= incident.title %></h5>
                        <p class="card-text text-muted small mb-2">
                            <i data-lucide="map-pin" style="width: 14px; height: 14px;"></i>
                            <%= incident.address %>
                        </p>
                        <p class="card-text flex-grow-1">
                            <%= incident.description.length > 120 ? incident.description.substring(0, 120) + '...' : incident.description %>
                        </p>
                        <div class="mb-3">
                            <span class="badge badge-severity-<%= incident.verifiedSeverity || incident.selfReportedSeverity %> me-1">
                                <%= incident.verifiedSeverity || incident.selfReportedSeverity %>
                            </span>
                            <span class="badge bg-secondary"><%= incident.category %></span>
                        </div>
                        <a href="/incidents/<%= incident._id %>" class="btn btn-sm btn-outline-primary mt-auto">View Details</a>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
<% } %>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        initializeMap('map', 20.5937, 78.9629, 4, true, window.incidentPopups);
    });
</script>
