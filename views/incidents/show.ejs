<% layout('layouts/boilerplate') %>

<!-- Map JS dependency -->
<script>
    window.incidentLng = <%= incident.location.coordinates[0] %>;
    window.incidentLat = <%= incident.location.coordinates[1] %>;
</script>

<div class="row">
    <div class="col-md-7 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <% if(incident.photos && incident.photos.length > 0) { %>
                <div id="incidentCarousel" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        <% incident.photos.forEach((img, i) => { %>
                        <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
                            <img src="<%= img.url %>" class="d-block w-100 incident-photo" alt="">
                        </div>
                        <% }) %>
                    </div>
                </div>
            <% } %>

            <div class="card-body">
                <h3 class="card-title"><%= incident.title %></h3>
                <p class="card-text text-muted mb-3"><%= incident.address %></p>

                <div class="mb-3">
                    <span class="badge badge-<%= incident.status %>">Status: <%= incident.status.toUpperCase() %></span>
                    <span class="badge bg-secondary"><%= incident.category.toUpperCase() %></span>
                    <% if (incident.status === 'verified') { %>
                        <span class="badge badge-severity-<%= incident.verifiedSeverity %>">Severity: <%= incident.verifiedSeverity %></span>
                    <% } else { %>
                        <span class="badge badge-severity-<%= incident.selfReportedSeverity %>">Self-Reported: <%= incident.selfReportedSeverity %></span>
                    <% } %>
                </div>

                <p class="card-text"><%= incident.description %></p>

                <% if (incident.reportedBy) { %>
                    <p class="text-muted mt-3 mb-0"><small>Reported by: <%= incident.reportedBy.username %></small></p>
                <% } %>
            </div>

            <% if(currentUser && (incident.reportedBy && incident.reportedBy.equals(currentUser._id) || currentUser.role === 'admin')) { %>
            <div class="card-footer bg-white border-top-0 pt-0 pb-3">
                <a class="btn btn-sm btn-outline-info" href="/incidents/<%= incident._id %>/edit">Edit</a>
                <form class="d-inline" action="<%= formAction('/incidents/' + incident._id + '?_method=DELETE') %>" method="POST">
                    <%- include('../includes/csrf') %>
                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </div>
            <% } %>
        </div>
    </div>
    <div class="col-md-5">
        <div id="map" class="mb-4"></div>
        <% if (incident.status === 'pending' && typeof canReview !== 'undefined' && canReview) { %>
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-body">
                    <h5 class="card-title">Accept or reject this report</h5>
                    <p class="small text-muted">You are among the nearest volunteers. Accepting verifies the incident and assigns it to you.</p>
                    <form action="<%= formAction('/incidents/' + incident._id + '/review') %>" method="POST">
                        <%- include('../includes/csrf') %>
                        <div class="mb-2">
                            <select name="status" class="form-select form-select-sm" required>
                                <option value="verified">Accept / verify</option>
                                <option value="rejected">Reject as false</option>
                                <option value="duplicate">Mark duplicate</option>
                            </select>
                        </div>
                        <div class="mb-2">
                            <select name="verifiedSeverity" class="form-select form-select-sm">
                                <option value="high" <%= incident.selfReportedSeverity==='high'?'selected':'' %>>High</option>
                                <option value="medium" <%= incident.selfReportedSeverity==='medium'?'selected':'' %>>Medium</option>
                                <option value="low" <%= incident.selfReportedSeverity==='low'?'selected':'' %>>Low</option>
                            </select>
                        </div>
                        <button class="btn btn-sm btn-primary w-100">Submit decision</button>
                    </form>
                </div>
            </div>
        <% } %>
        <% if (typeof nearestReviewers !== 'undefined' && nearestReviewers.length) { %>
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-body">
                    <h6 class="card-title">Nearest volunteers</h6>
                    <ul class="mb-0 ps-3">
                        <% for (const v of nearestReviewers) { %>
                            <li><%= v.username %></li>
                        <% } %>
                    </ul>
                </div>
            </div>
        <% } %>
        <% if (typeof nearbyShelters !== 'undefined' && nearbyShelters.length) { %>
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-body">
                    <h6 class="card-title">Nearby open shelters</h6>
                    <ul class="mb-0 ps-3">
                        <% for (const s of nearbyShelters) { %>
                            <li><a href="/shelters/<%= s._id %>"><%= s.name %></a> · <%= s.currentOccupancy %>/<%= s.totalCapacity %></li>
                        <% } %>
                    </ul>
                </div>
            </div>
        <% } %>
        <% if(currentUser && currentUser.role === 'admin') { %>
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title">Assign Volunteer</h5>
                    <form action="<%= formAction('/admin/assign') %>" method="POST">
                        <%- include('../includes/csrf') %>
                        <input type="hidden" name="targetType" value="incident">
                        <input type="hidden" name="targetId" value="<%= incident._id %>">
                        <div class="mb-2">
                            <label class="form-label" for="volunteerId">Volunteer ID</label>
                            <select class="form-select form-select-sm" name="volunteerId" id="volunteerId" required><option value="">-- Select Volunteer --</option><% for(let v of volunteers) { %> <option value="<%= v._id %>"><%= v.username %></option> <% } %></select>

                        </div>
                        <button class="btn btn-sm btn-primary">Assign Task</button>
                    </form>
                </div>
            </div>
        <% } %>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        initializeMap('map', window.incidentLat, window.incidentLng, 14, true, [{
            coordinates: [window.incidentLng, window.incidentLat],
            popupMarkup: '<b>Incident Location</b>'
        }]);
    });
</script>
