<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <meta name="theme-color" content="#f6f1ea">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="ResQ">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title>ResQ - Disaster Management</title>
    <!-- Favicon -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <!-- PWA Manifest -->
    <link rel="manifest" href="/manifest.json">
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,650&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap & Mapbox GL JS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/mobile-enhancements.css">
    <link rel="stylesheet" href="/css/theme.css">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="d-flex flex-column min-vh-100 body-fixed-nav" data-role="<%= currentUser ? currentUser.role : '' %>">
    <%- include('../includes/navbar') %>

    <main class="container mt-4 mb-5 flex-grow-1">
        <%- include('../includes/flash') %>
        <%- body %>
    </main>

    <%- include('../includes/footer') %>

    <!-- Mobile Bottom Navigation -->
    <nav class="mobile-bottom-nav">
        <div class="nav-item">
            <a class="nav-link <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/incidents') ? 'active' : '' %>" href="/incidents">
                <i data-lucide="alert-triangle"></i>
                <span>Incidents</span>
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/shelters') ? 'active' : '' %>" href="/shelters">
                <i data-lucide="home"></i>
                <span>Shelters</span>
            </a>
        </div>
        <div class="nav-item">
            <a class="nav-link <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/requests') ? 'active' : '' %>" href="/requests">
                <i data-lucide="package"></i>
                <span>Aid</span>
            </a>
        </div>
        <% if(currentUser && currentUser.role === 'admin') { %>
        <div class="nav-item">
            <a class="nav-link <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/admin') ? 'active' : '' %>" href="/admin/dashboard">
                <i data-lucide="layout-dashboard"></i>
                <span>Dashboard</span>
            </a>
        </div>
        <% } %>
        <% if(currentUser && (currentUser.role === 'volunteer' || currentUser.role === 'admin')) { %>
        <div class="nav-item">
            <a class="nav-link <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/assignments') ? 'active' : '' %>" href="/assignments">
                <i data-lucide="clipboard-list"></i>
                <span>Tasks</span>
            </a>
        </div>
        <% } %>
        <% if(!currentUser) { %>
        <div class="nav-item">
            <a class="nav-link <%= typeof currentPath !== 'undefined' && currentPath === '/login' ? 'active' : '' %>" href="/login">
                <i data-lucide="log-in"></i>
                <span>Login</span>
            </a>
        </div>
        <% } else { %>
        <div class="nav-item">
            <a class="nav-link <%= typeof currentPath !== 'undefined' && currentPath === '/profile' ? 'active' : '' %>" href="/profile">
                <i data-lucide="user"></i>
                <span>Hub</span>
            </a>
        </div>
        <% } %>
    </nav>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.js"></script>
    <script>window.MAPBOX_TOKEN = '<%= process.env.MAPBOX_TOKEN %>';</script>
    <script src="/js/map.js"></script>
    <script src="/js/forms.js"></script>
    <script src="/js/mobile-utils.js"></script>
    <script src="/js/volunteer-location.js"></script>
    <script src="/js/ui.js"></script>
    <script>
      lucide.createIcons();

      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/service-worker.js').catch(() => {});
        });
      }
    </script>
</body>
</html>
