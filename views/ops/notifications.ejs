<% layout('layouts/boilerplate') %>
<div class="alerts-head">
    <div>
        <p class="eyebrow mb-1">Operations</p>
        <h1 class="mb-0">Alerts</h1>
    </div>
    <% if (notes.length) { %>
        <form action="<%= formAction('/notifications/read') %>" method="POST">
            <%- include('../includes/csrf') %>
            <button class="btn btn-outline-secondary btn-sm">Mark all read</button>
        </form>
    <% } %>
</div>

<% if (!notes.length) { %>
    <div class="empty-state"><p>No alerts yet. Nearby incident and aid alerts appear here.</p></div>
<% } else { %>
    <div class="list-group alert-feed">
        <% for (const n of notes) { %>
            <a href="<%= n.href %>" class="list-group-item list-group-item-action alert-item <%= n.readAt ? '' : 'list-group-item-warning' %>">
                <div class="alert-item-top">
                    <strong class="alert-item-title"><%= n.title %></strong>
                    <time class="alert-item-time text-muted" datetime="<%= new Date(n.createdAt).toISOString() %>"><%= new Date(n.createdAt).toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' }) %></time>
                </div>
                <p class="alert-item-body small mb-0"><%= n.body %></p>
            </a>
        <% } %>
    </div>
<% } %>
