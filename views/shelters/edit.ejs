<% layout('layouts/boilerplate') %>
<div class="row justify-content-center">
    <div class="col-md-8">
        <h2 class="mb-4">Edit Shelter</h2>
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <form action="/shelters/<%= shelter._id %>?_method=PUT" method="POST" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label class="form-label" for="name">Shelter Name</label>
                        <input class="form-control" type="text" id="name" name="shelter[name]" value="<%= shelter.name %>" required>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label" for="totalCapacity">Total Capacity</label>
                            <input class="form-control" type="number" id="totalCapacity" name="shelter[totalCapacity]" min="1" value="<%= shelter.totalCapacity %>" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="currentOccupancy">Current Occupancy</label>
                            <input class="form-control" type="number" id="currentOccupancy" name="shelter[currentOccupancy]" min="0" value="<%= shelter.currentOccupancy %>" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="status">Status</label>
                            <select class="form-select" id="status" name="shelter[status]" required>
                                <option value="open" <%= shelter.status === 'open' ? 'selected' : '' %>>Open</option>
                                <option value="full" <%= shelter.status === 'full' ? 'selected' : '' %>>Full</option>
                                <option value="closed" <%= shelter.status === 'closed' ? 'selected' : '' %>>Closed</option>
                            </select>
                        </div>
                    </div>

                    <h5 class="mt-4">Location</h5>
                    <div id="map" class="mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label" for="address">Address string</label>
                        <input class="form-control" type="text" id="address" name="shelter[address]" value="<%= shelter.address %>" required>
                    </div>
                    <input type="hidden" name="shelter[latitude]" id="latitude" value="<%= shelter.location.coordinates[1] %>" required>
                    <input type="hidden" name="shelter[longitude]" id="longitude" value="<%= shelter.location.coordinates[0] %>" required>

                    <button class="btn btn-primary mt-3 w-100">Update Shelter</button>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        initializeMap('map', <%= shelter.location.coordinates[1] %>, <%= shelter.location.coordinates[0] %>, 13, false);
    });
</script>
