<% layout('layouts/boilerplate') %>
<div class="row justify-content-center">
    <div class="col-lg-8">
        <h2 class="mb-4">Update shelter</h2>
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form action="<%= formAction('/shelters/' + shelter._id + '?_method=PUT') %>" method="POST" class="needs-validation" novalidate>
                    <%- include('../includes/csrf') %>
                    <%- include('../includes/shelter-fields') %>

                    <h5 class="mt-4">Location</h5>
                    <div id="map" class="mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label" for="address">Address</label>
                        <input class="form-control" type="text" id="address" name="shelter[address]" value="<%= shelter.address %>" minlength="5" maxlength="300" required>
                    </div>
                    <input type="hidden" name="shelter[latitude]" id="latitude" value="<%= shelter.location.coordinates[1] %>" required>
                    <input type="hidden" name="shelter[longitude]" id="longitude" value="<%= shelter.location.coordinates[0] %>" required>

                    <button class="btn btn-primary mt-2 w-100">Save changes</button>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        initializeMap('map', <%= shelter.location.coordinates[1] %>, <%= shelter.location.coordinates[0] %>, 13, false);
    });
</script>
