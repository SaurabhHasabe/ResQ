<% layout('layouts/boilerplate') %>

<!-- Map JS dependency -->
<script>
    window.sLng = <%= shelter.location.coordinates[0] %>;
    window.sLat = <%= shelter.location.coordinates[1] %>;
</script>

<div class="row">
    <div class="col-md-7 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <h3 class="card-title"><%= shelter.name %></h3>
                <p class="card-text text-muted mb-3"><%= shelter.address %></p>

                <div class="mb-3">
                    <% if(shelter.status === 'open') { %>
                        <span class="badge bg-success">Status: Open</span>
                    <% } else if (shelter.status === 'full') { %>
                        <span class="badge bg-warning text-dark">Status: Full</span>
                    <% } else { %>
                        <span class="badge bg-danger">Status: Closed</span>
                    <% } %>
                </div>

                <div class="row text-center my-4">
                    <div class="col-6 border-end">
                        <h4 class="mb-0"><%= shelter.currentOccupancy %></h4>
                        <small class="text-muted">Current Occupancy</small>
                    </div>
                    <div class="col-6">
                        <h4 class="mb-0"><%= shelter.totalCapacity %></h4>
                        <small class="text-muted">Total Capacity</small>
                    </div>
                </div>

                <% const pct = Math.min(100, Math.max(0, (shelter.currentOccupancy / shelter.totalCapacity) * 100)); %>
                <div class="progress mb-4" style="height: 10px;">
                    <div class="progress-bar <%= pct >= 100 ? 'bg-danger' : 'bg-success' %>" role="progressbar" style="width: <%= pct %>%;"></div>
                </div>
            </div>

            <% if(currentUser && currentUser.role === 'admin') { %>
            <div class="card-footer bg-white border-top-0 pt-0 pb-3">
                <a class="btn btn-sm btn-outline-info" href="/shelters/<%= shelter._id %>/edit">Edit Shelter</a>
                <form class="d-inline" action="<%= formAction('/shelters/' + shelter._id + '?_method=DELETE') %>" method="POST">
                    <%- include('../includes/csrf') %>
                    <button class="btn btn-sm btn-outline-danger">Remove</button>
                </form>
            </div>
            <% } %>
        </div>
    </div>
    <div class="col-md-5">
        <div id="map" class="mb-4"></div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        initializeMap('map', window.sLat, window.sLng, 14, true, [{
            coordinates: [window.sLng, window.sLat],
            popupMarkup: <%- JSON.stringify(shelter.name) %>
        }]);
    });
</script>
