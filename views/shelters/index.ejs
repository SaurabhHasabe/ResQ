<% layout('layouts/boilerplate') %>

<!-- Map JS dependency -->
<script>
    window.shelterPopups = <%- JSON.stringify(shelters.map(s => ({
        coordinates: s.location.coordinates,
        popupMarkup: `<b>${s.name}</b><br>Capacity: ${s.currentOccupancy}/${s.totalCapacity}`
    }))) %>;
</script>

<div class="row mb-4">
    <div class="col-md-8">
        <h1 class="mb-3">Emergency Shelters</h1>
    </div>
    <div class="col-md-4 text-end">
        <% if (currentUser && currentUser.role === 'admin') { %>
            <a href="/shelters/new" class="btn btn-primary">Add Shelter</a>
        <% } %>
    </div>
</div>

<div class="row">
    <div class="col-lg-7">
        <% if (shelters.length === 0) { %>
            <div class="empty-state"><i data-lucide="home" class="icon-lg mx-auto text-muted mb-3 d-block"></i><h4>No shelters found</h4><p>There are no shelters registered currently.</p></div>
        <% } %>
        <% for(let s of shelters) { %>
            <div class="card mb-3 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title"><%= s.name %></h5>
                    <p class="card-text text-muted mb-2"><%= s.address %></p>
                    <div class="mb-2">
                        <% if(s.status === 'open') { %>
                            <span class="badge bg-success">Open</span>
                        <% } else if(s.status === 'full') { %>
                            <span class="badge bg-warning text-dark">Full</span>
                        <% } else { %>
                            <span class="badge bg-danger">Closed</span>
                        <% } %>
                        <span class="badge bg-secondary ms-2">Occupancy: <%= s.currentOccupancy %> / <%= s.totalCapacity %></span>
                    </div>
                    <!-- simple progress bar -->
                    <div class="progress mb-3" style="height: 5px;">
                        <% const pct = Math.min(100, Math.max(0, (s.currentOccupancy / s.totalCapacity) * 100)); %>
                        <div class="progress-bar <%= pct >= 100 ? 'bg-danger' : 'bg-success' %>" role="progressbar" style="width: <%= pct %>%;"></div>
                    </div>

                    <a class="btn btn-sm btn-outline-primary" href="/shelters/<%= s._id %>">View Details</a>

                    <% if (currentUser && currentUser.role === 'admin') { %>
                        <a class="btn btn-sm btn-outline-info ms-1" href="/shelters/<%= s._id %>/edit">Manage</a>
                    <% } %>
                </div>
            </div>
        <% } %>
    </div>
    <div class="col-lg-5">
        <div id="map" class="sticky-top" style="top: 20px;"></div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        initializeMap('map', 20.5937, 78.9629, 4, true, window.shelterPopups);
    });
</script>
