<% layout('layouts/boilerplate') %>

<div class="row">
    <div class="col-12 mb-4">
        <h1 class="mb-3">My Profile</h1>
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h4><i data-lucide="user" class="icon-sm"></i> <%= currentUser.username %></h4>
                <p class="text-muted mb-0">Role: <span class="badge bg-secondary text-capitalize"><%= currentUser.role %></span></p>
                <p class="text-muted mb-0">Email: <%= currentUser.email %></p>
                <% if (currentUser.phone) { %>
                    <p class="text-muted mb-0">Phone: <%= currentUser.phone %></p>
                <% } %>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-4">
        <h3>My Reported Incidents</h3>
        <% if(incidents && incidents.length > 0) { %>
            <div class="list-group">
                <% for(let inc of incidents) { %>
                    <a href="/incidents/<%= inc._id %>" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-1"><%= inc.title %></h5>
                            <small class="text-muted"><%= inc.category %></small>
                        </div>
                        <span class="badge badge-<%= inc.status %>">
                            <%= inc.status.toUpperCase() %>
                        </span>
                    </a>
                <% } %>
            </div>
        <% } else { %>
            <div class="empty-state">
                <i data-lucide="alert-circle" class="icon-lg"></i>
                <p>You haven't reported any incidents yet.</p>
            </div>
        <% } %>
    </div>
    <div class="col-md-6 mb-4">
        <h3>My Aid Requests</h3>
        <% if(requests && requests.length > 0) { %>
            <div class="list-group">
                <% for(let req of requests) { %>
                    <a href="/requests/<%= req._id %>" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-1 text-capitalize"><%= req.type %></h5>
                            <small class="text-muted">Urgency: <%= req.urgency %></small>
                        </div>
                        <span class="badge badge-<%= req.status %>">
                            <%= req.status.toUpperCase() %>
                        </span>
                    </a>
                <% } %>
            </div>
        <% } else { %>
            <div class="empty-state">
                <i data-lucide="helping-hand" class="icon-lg"></i>
                <p>You haven't made any aid requests yet.</p>
            </div>
        <% } %>
    </div>
</div>
