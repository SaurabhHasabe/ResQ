<% layout('layouts/boilerplate') %>
<div class="row justify-content-center py-3 py-md-4">
        <div class="col-12 col-sm-10 col-md-7 col-lg-5">
            <div class="text-center mb-4">
                <p class="eyebrow">Start as a citizen</p>
                <h2>Join ResQ</h2>
                <p class="text-muted">Every account begins as a citizen. You can report incidents, request aid, and offer shelter. Volunteer access is granted later by an admin.</p>
            </div>
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form action="<%= formAction('/register') %>" method="POST" class="needs-validation" novalidate>
                        <%- include('../includes/csrf') %>
                        <div class="mb-3">
                            <label class="form-label" for="username">Username</label>
                            <input class="form-control" type="text" id="username" name="username" minlength="3" maxlength="30" pattern="[A-Za-z0-9_]{3,30}" required autofocus>
                            <div class="form-text">3–30 letters, numbers, or underscores.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="email">Email</label>
                            <input class="form-control" type="email" id="email" name="email" maxlength="254" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="phone">Phone</label>
                            <input class="form-control" type="tel" id="phone" name="phone" inputmode="numeric" maxlength="13" pattern="^(\+91)?[6-9][0-9]{9}$" placeholder="10-digit Indian mobile" required>
                            <div class="invalid-feedback">Enter a valid 10-digit Indian mobile number.</div>
                            <div class="form-text">Required. Used with your username if you forget your password. 10 digits, starting with 6–9.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="password">Password</label>
                            <input class="form-control" type="password" id="password" name="password" minlength="8" maxlength="128" required>
                            <div class="form-text">At least 8 characters.</div>
                        </div>
                        <button class="btn btn-primary w-100">Create citizen account</button>
                    </form>
                    <div class="mt-3 text-center">
                        <small>Already registered? <a href="/login">Login</a></small>
                    </div>
                </div>
            </div>
        </div>
</div>
