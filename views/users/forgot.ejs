<% layout('layouts/boilerplate') %>
<div class="row justify-content-center py-4">
    <div class="col-12 col-md-6 col-lg-4">
        <h2 class="mb-3">Reset password</h2>
        <p class="text-muted">Confirm your username and the Indian mobile number on your account, then choose a new password. No email is sent.</p>
        <div class="card shadow-sm">
            <div class="card-body">
                <form action="<%= formAction('/forgot') %>" method="POST" class="needs-validation" novalidate>
                    <%- include('../includes/csrf') %>
                    <div class="mb-3">
                        <label class="form-label" for="username">Username</label>
                        <input class="form-control" type="text" id="username" name="username" minlength="3" maxlength="30" pattern="[A-Za-z0-9_]{3,30}" required autofocus>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="phone">Phone</label>
                        <input class="form-control" type="tel" id="phone" name="phone" inputmode="numeric" maxlength="13" pattern="^(\+91)?[6-9][0-9]{9}$" required>
                        <div class="form-text">The 10-digit number you registered with.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="password">New password</label>
                        <input class="form-control" type="password" id="password" name="password" minlength="8" maxlength="128" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="confirmPassword">Confirm password</label>
                        <input class="form-control" type="password" id="confirmPassword" name="confirmPassword" minlength="8" maxlength="128" required>
                    </div>
                    <button class="btn btn-primary w-100">Update password</button>
                </form>
            </div>
        </div>
        <p class="small text-muted mt-3 mb-0">No phone on file? An admin can issue a temporary password from the dashboard.</p>
        <p class="text-center mt-3"><a href="/login">Back to login</a></p>
    </div>
</div>
