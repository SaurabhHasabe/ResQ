<% layout('layouts/boilerplate') %>
<div class="row justify-content-center py-3 py-md-4 auth-shell">
        <div class="col-12 col-sm-10 col-md-6 col-lg-4">
            <div class="text-center mb-4">
                <p class="eyebrow mb-2">Welcome back</p>
                <h2 class="mb-1">Sign in to ResQ</h2>
                <p class="text-muted mb-0">Continue reporting, volunteering, or coordinating response.</p>
            </div>
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h5 class="card-title visually-hidden">Login</h5>
                    <form action="<%= formAction('/login') %>" method="POST" class="needs-validation" novalidate>
                        <%- include('../includes/csrf') %>
                        <div class="mb-3">
                            <label class="form-label" for="username">Username</label>
                            <input class="form-control" type="text" id="username" name="username" maxlength="30" required autofocus>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="password">Password</label>
                            <input class="form-control" type="password" id="password" name="password" maxlength="128" required>
                        </div>
                        <button class="btn btn-primary w-100">Login</button>
                    </form>
                    <div class="mt-3 text-center">
                        <small><a href="/forgot">Forgot password?</a></small><br>
                        <small>New here? <a href="/register">Create a citizen account</a></small>
                    </div>
                </div>
            </div>
        </div>
</div>
